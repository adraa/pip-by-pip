---
type Step = { title: string; body: string };
type Props = { steps: Step[] };
const { steps } = Astro.props;
---

<ol class="my-8 grid gap-0">
  {
    steps.map((step, index) => (
      <li class="relative grid grid-cols-[2rem_1fr] gap-3 pb-5 last:pb-0">
        <div class="flex flex-col items-center">
          <span class="flex size-7 items-center justify-center rounded-full border border-rule bg-raised font-sans text-[0.75rem] font-semibold text-accent tabular-nums">
            {index + 1}
          </span>
          {index < steps.length - 1 && <span class="mt-1 w-px flex-1 bg-rule" aria-hidden="true" />}
        </div>
        <div class="pt-0.5">
          <p class="font-sans text-[0.9rem] font-semibold text-ink">{step.title}</p>
          <p class="mt-0.5 text-[0.95em] leading-relaxed text-ink-soft">{step.body}</p>
        </div>
      </li>
    ))
  }
</ol>
