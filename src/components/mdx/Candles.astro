---
/**
 * A small candlestick chart drawn from frozen example data.
 * Each candle is [open, high, low, close].
 */
type Candle = [number, number, number, number];

type Marker = { index: number; label: string; kind?: 'buy' | 'sell' | 'note' };

type Props = {
  candles: Candle[];
  markers?: Marker[];
  /** Horizontal reference lines, e.g. a support level. */
  levels?: Array<{ price: number; label: string }>;
  height?: number;
};

const { candles, markers = [], levels = [], height = 200 } = Astro.props;

const width = 640;
const padding = { top: 14, right: 54, bottom: 14, left: 8 };
const innerWidth = width - padding.left - padding.right;
const innerHeight = height - padding.top - padding.bottom;

const highs = candles.map((candle) => candle[1]);
const lows = candles.map((candle) => candle[2]);
const levelPrices = levels.map((level) => level.price);
const max = Math.max(...highs, ...levelPrices);
const min = Math.min(...lows, ...levelPrices);
const range = max - min || 1;
const pad = range * 0.12;

const y = (price: number) => padding.top + ((max + pad - price) / (range + pad * 2)) * innerHeight;
const slot = innerWidth / candles.length;
const bodyWidth = Math.min(slot * 0.62, 16);
const x = (index: number) => padding.left + slot * index + slot / 2;

const decimals = max > 50 ? 2 : 4;
---

<div class="py-1">
  <svg viewBox={`0 0 ${width} ${height}`} class="w-full" role="img" aria-label="Example price chart">
    {
      levels.map((level) => (
        <g>
          <line
            x1={padding.left}
            x2={width - padding.right}
            y1={y(level.price)}
            y2={y(level.price)}
            stroke="var(--color-accent)"
            stroke-width="1"
            stroke-dasharray="4 4"
            opacity="0.7"
          />
          <text
            x={width - padding.right + 6}
            y={y(level.price) + 3.5}
            fill="var(--color-accent)"
            font-size="10"
            font-family="var(--font-sans)"
          >
            {level.label}
          </text>
        </g>
      ))
    }

    {
      candles.map((candle, index) => {
        const [open, high, low, close] = candle;
        const rising = close >= open;
        const colour = rising ? 'var(--color-rise)' : 'var(--color-fall)';
        const top = y(Math.max(open, close));
        const bottom = y(Math.min(open, close));
        return (
          <g>
            <line x1={x(index)} x2={x(index)} y1={y(high)} y2={y(low)} stroke={colour} stroke-width="1.2" />
            <rect
              x={x(index) - bodyWidth / 2}
              y={top}
              width={bodyWidth}
              height={Math.max(bottom - top, 1.5)}
              fill={rising ? 'transparent' : colour}
              stroke={colour}
              stroke-width="1.4"
              rx="1"
            />
          </g>
        );
      })
    }

    {
      markers.map((marker) => {
        const candle = candles[marker.index];
        if (!candle) return null;
        const above = marker.kind === 'sell';
        const anchorY = above ? y(candle[1]) - 10 : y(candle[2]) + 16;
        const colour =
          marker.kind === 'buy' ? 'var(--color-rise)' : marker.kind === 'sell' ? 'var(--color-fall)' : 'var(--color-ink-faint)';
        return (
          <text
            x={x(marker.index)}
            y={anchorY}
            fill={colour}
            font-size="10.5"
            font-family="var(--font-sans)"
            font-weight="600"
            text-anchor="middle"
          >
            {marker.label}
          </text>
        );
      })
    }

    <text
      x={width - padding.right + 6}
      y={y(max) + 3.5}
      fill="var(--color-ink-faint)"
      font-size="10"
      font-family="var(--font-sans)">{max.toFixed(decimals)}</text
    >
    <text
      x={width - padding.right + 6}
      y={y(min) + 3.5}
      fill="var(--color-ink-faint)"
      font-size="10"
      font-family="var(--font-sans)">{min.toFixed(decimals)}</text
    >
  </svg>
</div>
