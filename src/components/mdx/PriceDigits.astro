---
type Props = {
  /** e.g. "1.08505" — the pip digit and pipette are highlighted automatically. */
  price?: string;
  /** JPY pairs put the pip in a different place. */
  jpy?: boolean;
  label?: string;
};

const { price = '1.08505', jpy = false, label } = Astro.props;

const [whole, decimals = ''] = price.split('.');
const pipIndex = jpy ? 1 : 3;
const digits = decimals.split('');
---

<div class="flex flex-col items-center gap-4 py-2">
  {label && <p class="label">{label}</p>}

  <div class="flex items-end font-sans text-4xl tabular-nums sm:text-5xl">
    <span class="text-ink-soft">{whole}.</span>
    {
      digits.map((digit, index) => (
        <span
          class:list={[
            'relative px-[0.06em]',
            index === pipIndex ? 'font-semibold text-accent' : index > pipIndex ? 'text-ink-faint' : 'text-ink-soft',
          ]}
        >
          {digit}
          {index === pipIndex && (
            <span class="absolute inset-x-0 -bottom-1 h-0.5 rounded-full bg-accent" aria-hidden="true" />
          )}
        </span>
      ))
    }
  </div>

  <div class="flex flex-wrap justify-center gap-x-6 gap-y-2 font-sans text-[0.8rem]">
    <span class="flex items-center gap-1.5 text-accent">
      <span class="inline-block h-0.5 w-4 rounded-full bg-accent"></span>
      the pip
    </span>
    {
      digits.length > pipIndex + 1 && (
        <span class="flex items-center gap-1.5 text-ink-faint">
          <span class="inline-block h-0.5 w-4 rounded-full bg-ink-faint/50" />
          the pipette, one tenth of a pip
        </span>
      )
    }
  </div>
</div>
