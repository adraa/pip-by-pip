---
type Props = { caption?: string };
const { caption = 'Every bar is one trading session. Slide through the day and watch which desks are awake.' } =
  Astro.props;

/** Hours are GMT. These are the standard session windows the school uses. */
const sessions = [
  { name: 'Sydney', open: 21, close: 6, tint: 'var(--color-flag)' },
  { name: 'Tokyo', open: 0, close: 9, tint: '#7b6bd6' },
  { name: 'London', open: 7, close: 16, tint: 'var(--color-accent)' },
  { name: 'New York', open: 12, close: 21, tint: 'var(--color-fall)' },
];

function segments(session: { open: number; close: number }) {
  return session.open < session.close
    ? [{ start: session.open, width: session.close - session.open }]
    : [
        { start: session.open, width: 24 - session.open },
        { start: 0, width: session.close },
      ];
}

const startHour = 13;
---

<figure class="my-8">
  <div class="rounded-xl border border-rule bg-raised p-4 sm:p-6" data-sessions data-hour={startHour}>
    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
      <p class="label">Drag to move through the day</p>
      <p class="font-sans text-sm tabular-nums text-ink-soft">
        <span data-gmt>13:00</span> GMT
        <span class="text-ink-faint"> · <span data-local>13:00</span> your time</span>
      </p>
    </div>

    <div class="relative mt-4">
      <div class="grid gap-2">
        {
          sessions.map((session) => (
            <div
              class="grid grid-cols-[4.6rem_1fr] items-center gap-2 sm:grid-cols-[6rem_1fr] sm:gap-3"
              data-session
              data-open={session.open}
              data-close={session.close}
              data-name={session.name}
            >
              <span data-session-name class="font-sans text-[0.78rem] text-ink-faint sm:text-[0.85rem]">
                {session.name}
              </span>
              <div class="relative h-7 overflow-hidden rounded-md bg-sunk">
                {segments(session).map((segment) => (
                  <div
                    data-band
                    class="absolute inset-y-0 rounded-md transition-opacity duration-200"
                    style={`left:${(segment.start / 24) * 100}%;width:${(segment.width / 24) * 100}%;background-color:${session.tint};opacity:0.28`}
                  />
                ))}
              </div>
            </div>
          ))
        }
      </div>

      <div class="pointer-events-none absolute inset-y-0 right-0 left-[4.6rem] sm:left-[6rem]">
        <div class="relative h-full">
          <div
            data-playhead
            class="absolute inset-y-0 w-0.5 -translate-x-1/2 rounded-full bg-ink"
            style={`left:${((startHour + 0.5) / 24) * 100}%`}
          >
          </div>
        </div>
      </div>
    </div>

    <div class="mt-3 grid grid-cols-[4.6rem_1fr] gap-2 sm:grid-cols-[6rem_1fr] sm:gap-3">
      <span></span>
      <div>
        <input
          type="range"
          min="0"
          max="23"
          step="1"
          value={startHour}
          data-hour-input
          aria-label="Hour of the day, GMT"
          class="w-full accent-[var(--color-accent)]"
        />
        <div class="mt-0.5 flex justify-between font-sans text-[0.68rem] tabular-nums text-ink-faint">
          <span>00</span><span>06</span><span>12</span><span>18</span><span>23</span>
        </div>
      </div>
    </div>

    <div class="mt-4 rounded-lg border border-rule bg-sunk px-4 py-3">
      <p data-open-list class="font-sans text-[0.85rem] text-ink">Open: London, New York.</p>
      <p data-busy class="mt-1 font-sans text-[0.8rem] text-ink-faint">
        Busy. Two sessions open at once, so prices move fastest.
      </p>
    </div>
  </div>
  {caption && <figcaption class="mt-2.5 font-sans text-[0.8rem] leading-relaxed text-ink-faint">{caption}</figcaption>}
</figure>

<script>
  function pad(hour: number) {
    return `${String(((hour % 24) + 24) % 24).padStart(2, '0')}:00`;
  }

  document.querySelectorAll<HTMLElement>('[data-sessions]').forEach((widget) => {
    const input = widget.querySelector<HTMLInputElement>('[data-hour-input]')!;
    const playhead = widget.querySelector<HTMLElement>('[data-playhead]')!;
    const gmt = widget.querySelector<HTMLElement>('[data-gmt]')!;
    const local = widget.querySelector<HTMLElement>('[data-local]')!;
    const openList = widget.querySelector<HTMLElement>('[data-open-list]')!;
    const busy = widget.querySelector<HTMLElement>('[data-busy]')!;
    const rows = Array.from(widget.querySelectorAll<HTMLElement>('[data-session]'));
    const offset = -new Date().getTimezoneOffset() / 60;

    function update(hour: number) {
      playhead.style.left = `${((hour + 0.5) / 24) * 100}%`;
      gmt.textContent = pad(hour);
      local.textContent = pad(hour + offset);

      const open: string[] = [];

      for (const row of rows) {
        const from = Number(row.dataset.open);
        const to = Number(row.dataset.close);
        const isOpen = from < to ? hour >= from && hour < to : hour >= from || hour < to;
        if (isOpen) open.push(row.dataset.name!);

        row.querySelectorAll<HTMLElement>('[data-band]').forEach((band) => {
          band.style.opacity = isOpen ? '0.85' : '0.28';
        });

        const name = row.querySelector<HTMLElement>('[data-session-name]')!;
        name.classList.toggle('font-semibold', isOpen);
        name.classList.toggle('text-ink', isOpen);
        name.classList.toggle('text-ink-faint', !isOpen);
      }

      openList.textContent = open.length === 0 ? 'Nobody much is trading.' : `Open: ${open.join(', ')}.`;
      busy.textContent =
        open.length >= 2
          ? 'Busy. Two sessions open at once, so prices move fastest.'
          : open.length === 1
            ? 'Moderate. One session open.'
            : 'Almost still. The market is technically open, but barely awake.';
    }

    input.addEventListener('input', () => update(Number(input.value)));
    update(Number(input.value));
  });
</script>
